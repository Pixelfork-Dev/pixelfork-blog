# Public URL of the blog including the /blog sub-path, no trailing slash. Sets Next's basePath and all
# canonical/sitemap/RSS/OG URLs. Production: https://pixelfork.ai/blog
NEXT_PUBLIC_SITE_URL=http://localhost:3000/blog

# Postgres. Production: Supabase transaction pooler URI (port 6543). Locally run `npm run db:local` and use:
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:54329/postgres
# Optional: Supabase's SSL certificate (PEM) to verify the database server in production.
DATABASE_CA_CERT=

# Auth.js. Production: AUTH_URL=https://pixelfork.ai/blog/api/auth (locally leave empty).
AUTH_URL=
# Generate with: npx auth secret   (or: openssl rand -base64 32)
AUTH_SECRET=
# Google OAuth client (Google Cloud Console → APIs & Services → Credentials)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Comma-separated emails that become admins on first Google sign-in (bootstrap). Everyone else must be invited.
ADMIN_EMAILS=

# Local only: allow a password-less email login at /admin/login for testing. Never set in production.
AUTH_DEV_LOGIN=

# Search console verification tokens (optional)
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_BING_SITE_VERIFICATION=

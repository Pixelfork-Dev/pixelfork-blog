# Public URL of the blog, no trailing slash. Used for canonical URLs, sitemap, RSS, OG and JSON-LD.
NEXT_PUBLIC_SITE_URL=https://blog.pixelfork.ai

# Postgres. Vercel + Neon sets this automatically; locally run `npm run db:local` and use:
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:54329/postgres

# Auth.js — generate with: npx auth secret   (or: openssl rand -base64 32)
AUTH_SECRET=
# Google OAuth client (Google Cloud Console → APIs & Services → Credentials)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Comma-separated emails that become admins on first Google sign-in (bootstrap). Everyone else must be invited.
ADMIN_EMAILS=

# Local only: allow a password-less email login at /admin/login for testing. Never set in production.
AUTH_DEV_LOGIN=

# Search console verification tokens (optional)
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_BING_SITE_VERIFICATION=
